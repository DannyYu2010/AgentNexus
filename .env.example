# Local Qwen OpenAI-compatible endpoint
QWEN_BASE_URL=http://127.0.0.1:8080/v1
QWEN_API_KEY=local
QWEN_MODEL=mlx-community/Qwen3.8-27B-4bit

# Local persistence. Keep this outside temporary directories.
MEMORY_DATA_DIR=./data
MEM0_USER_ID=local-user
MEM0_COLLECTION_NAME=agent_memories

# Use "server" for concurrent Codex/WorkBuddy access. "local" remains
# available for isolated tests and migration.
QDRANT_MODE=server
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# Local embedding model
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIMS=1024

# Keep OSS usage private by default.
MEM0_TELEMETRY=false

# Set by the AgentNexus Memory launcher. "state-only" keeps Project State
# available without loading Mem0, embeddings, Qdrant, or Qwen.
AGENT_MEMORY_MODE=full
